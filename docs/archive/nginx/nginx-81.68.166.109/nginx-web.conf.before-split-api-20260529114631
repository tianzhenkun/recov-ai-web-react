http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;
    # 限制body大小
    client_max_body_size 100m;
    # 开启静态资源压缩
    #    gzip_static on;




    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                          '$status $body_bytes_sent "$http_referer" '
                          '"$http_user_agent" "$http_x_forwarded_for"';

    #    access_log  /var/log/nginx/access.log  main;

    # 主域名后端（原配置）
    upstream server {
        ip_hash;
        server 127.0.0.1:8867;
    }

    # 新增：子域名app.lingchen-ai.com对应的后端（指向8866端口）
    upstream app-server {
        ip_hash; # 保持与主域名一致的负载均衡策略（单节点不影响，便于后续扩展）
        server 127.0.0.1:8866;
    }

    upstream server-dev {
        ip_hash;
        server 127.0.0.1:8867;
    }

    upstream server-test {
        ip_hash;
        server 127.0.0.1:8867;
    }

    upstream monitor-admin {
        server 127.0.0.1:9090;
    }

    upstream snailjob-server {
        server 127.0.0.1:8800;
    }

    # 添加 ONLYOFFICE 上游服务
    # 假设您的 ONLYOFFICE Document Server 运行在 127.0.0.1:8080（请根据实际情况修改）
    upstream onlyoffice-backend {
        server 127.0.0.1:8443;
        # 如果有多个实例可以添加更多服务器
        # server 127.0.0.1:8081;
    }

    # 映射协议和主机头（用于 ONLYOFFICE）
    map $http_x_forwarded_proto $the_scheme {
        default $http_x_forwarded_proto;
        "" $scheme;
    }

    map $http_x_forwarded_host $the_host {
        default $http_x_forwarded_host;
        "" $host;
    }

    map $http_upgrade $proxy_connection {
        default upgrade;
        "" close;
    }

# 统一处理所有目标域名的 HTTP 请求，自动跳转到对应的 HTTPS 域名
server {
    listen 80;  # 监听所有IP的80端口（若服务器绑定特定IP，可写为 listen 你的公网IP:80;）
    # 包含所有需要跳转的域名（空格分隔）
    server_name
        lingchen-ai.com
        www.lingchen-ai.com
        law.lingchen-ai.com
        www.law.lingchen-ai.com
		doc.lingchen-ai.com
		www.doc.lingchen-ai.com
        recov.lingchen-ai.com;

    # 核心：301永久跳转（$host自动匹配当前访问的域名，保留请求路径）
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name doc.lingchen-ai.com;

    # 独立SSL证书（替换为你的实际文件名）
    ssl_certificate doc.lingchen-ai.com_bundle.crt;
    ssl_certificate_key doc.lingchen-ai.com.key;

    # 复用law域名的SSL安全配置
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE;
    ssl_prefer_server_ciphers on;

    # 【核心安全规则】和law域名完全一致
    # 禁止外网访问actuator路径
    location ~ ^(/[^/]*)?/actuator.*(/.*)?$ {
        return 403;
    }
    # 禁止访问隐藏目录/文件（含.svn）
    location ~ /\. {
        deny all;
        return 404;
    }
    # 禁止访问敏感文件类型
    location ~* \.(bak|sql|log|conf|ini|key|pem|svn-base)$ {
        deny all;
        return 404;
    }

    # ===================== 静态界面配置（参考law域名，仅改路径） =====================
    # 【你需要改这里】doc域名的静态文件根目录（替换为实际路径）
    location / {
        root   /home/lingchen/web/doc/dist;  # 示例路径，改成你的实际静态文件位置
        try_files $uri $uri/ /index.html;    # 适配SPA前端路由（刷新不404）
        index  index.html index.htm;
    }
# ===================== MinIO PDF 访问代理（解决 HTTPS 混合内容，100%可用） =====================
location /certificate/ {

    # 关键：把 /certificate/ 去掉，把后面路径带给 MinIO
    rewrite ^/certificate/(.*)$ /$1 break;

    # 你的 MinIO 地址（保持 http 即可，nginx 内部代理，浏览器看不到）
    proxy_pass http://127.0.0.1:9000;

    # 必须的头部，让 MinIO 正常识别请求
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;  # 告诉 MinIO 外面是 HTTPS

    # 大文件 / PDF 支持
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding on;

    # 超时
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # 让浏览器直接预览 PDF，不下载
    add_header Content-Type "application/pdf";
    add_header Content-Disposition "inline";
}
