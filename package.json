    "@tiptap/extension-color": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/pm": "^3.23.2",
    "@tiptap/react": "^3.23.2",
    "@tiptap/starter-kit": "^3.23.2",
    "antd": "^6.3.7",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "jsencrypt": "^3.5.4",
    "markdown-it": "^14.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-pdf": "^10.4.1",
    "topojson-client": "^3.1.0",
    "turndown": "^7.2.4"
