    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/turndown": "^5.0.6",
    "@umijs/lint": "^4.6.51",
